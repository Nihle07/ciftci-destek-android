rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: checks if the authenticated user has the 'admin' role in their user document
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection rules
    match /users/{userId} {
      // Users can read and write only their own profiles
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Tarim Noktalari (Agricultural Points) rules
    match /tarim_noktalari/{documentId} {
      // Any logged-in user can read agricultural points
      allow read: if isAuthenticated();
      
      // Only administrators can create, update, or delete agricultural points
      allow write: if isAdmin();
    }
  }
}
