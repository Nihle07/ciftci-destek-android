<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_screen"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="vertical"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Yeni Tarım Noktası Ekle"
            android:textColor="#154212"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Haritada gösterilecek yeni tarımsal destek noktasının bilgilerini girin."
            android:textColor="#42493E"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_auth_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nokta Adı"
                android:textColor="#191C1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtNoktaAdi"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Örn: Adapazarı zirai market"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#191C1A"
                android:textColorHint="#72796E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Kategori"
                android:textColor="#191C1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtKategori"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Örn: Tarım Market"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#191C1A"
                android:textColorHint="#72796E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="İlçe"
                android:textColor="#191C1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtIlce"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Örn: Adapazarı"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#191C1A"
                android:textColorHint="#72796E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Telefon"
                android:textColor="#191C1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTelefon"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Örn: 05xxxxxxxxx"
                android:inputType="phone"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#191C1A"
                android:textColorHint="#72796E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Açıklama"
                android:textColor="#191C1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtAciklama"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:gravity="top"
                android:hint="Kısa açıklama girin"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:textColor="#191C1A"
                android:textColorHint="#72796E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Web Sitesi"
                android:textColor="#191C1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtWebSitesi"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Örn: https://www.orneksite.com"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#191C1A"
                android:textColorHint="#72796E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Latitude / Enlem"
                android:textColor="#191C1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtLatitude"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Örn: 40.7777"
                android:inputType="numberDecimal|numberSigned"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#191C1A"
                android:textColorHint="#72796E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Longitude / Boylam"
                android:textColor="#191C1A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtLongitude"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="Örn: 30.4010"
                android:inputType="numberDecimal|numberSigned"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#191C1A"
                android:textColorHint="#72796E" />

            <Button
                android:id="@+id/btnKaydet"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:text="Kaydet"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>